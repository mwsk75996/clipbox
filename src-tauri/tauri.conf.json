{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipbox",
  "version": "0.1.0",
  "identifier": "com.palethea.clipbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Clipbox",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
