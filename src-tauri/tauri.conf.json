{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipbox",
  "version": "1.0.0",
  "identifier": "com.palethea.clipbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clipbox",
        "width": 900,
        "height": 700,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
